# Priced - copy to .env.local and fill before launch.
# Demo local and ordinary PR previews require no credentials. The app runs on
# an in-memory market with a simulated payment provider.
# Current free-beta strategy: one designated hosted beta deployment uses the
# existing Priced Supabase project, Dodo TEST credentials, and one free Upstash
# Redis database. Ordinary untrusted PR previews stay in demo mode.
# Do not create another Supabase project solely for Preview while staying free.

# Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: Dodo is the approved launch default
# Server-only secrets. Never expose to the browser. Never commit real values.
# Product eligibility/verification for Priced has been confirmed by the owner.
# Test mode: DODO_PAYMENTS_MODE=test and use Dodo test API/webhook credentials.
# Live mode: separate live API/webhook credentials after hosted staging is green.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# Optional billing currency override. Default USD.
# This is the ONE currency Priced settles in. It is used both to open the Dodo
# checkout and to validate the settlement currency on every succeeded webhook:
# a payment that settles in any other currency is refunded, never applied,
# because market prices are integer minor units of THIS currency only.
# DODO_PAYMENTS_CURRENCY=USD

# Optional grace window, in milliseconds, for a payment that lands just after
# its quote's 5-minute TTL. DEFAULT 0 = the locked TTL behaviour, unchanged.
#
# Why you may want this on: the TTL protects against a stale PRICE, not a slow
# payer. 3-D Secure with an SMS OTP, app-switching to a banking app, and
# UPI/netbanking redirects routinely take longer than five minutes. With a
# grace of 0 those buyers are charged and then auto-refunded even though
# nobody outbid them — costing a refund fee and a support ticket each time.
#
# Why it is safe: a late payment still goes through finalize_takeover, which
# re-validates version AND price under the row lock. It is honoured only when
# the market has not moved at all; if anything moved it becomes STALE_QUOTE and
# refunds exactly as before. Amount checks are never relaxed.
#
# The 5-minute TTL is listed under "Locked market mechanics" in AGENTS.md, so
# enabling this is an OWNER decision. 900000 = 15 minutes. Max 24h.
# QUOTE_LATE_PAYMENT_GRACE_MS=0
# Optional self-hosted/proxy base URL override.
# DODO_PAYMENTS_BASE_URL=

# Payments: Stripe optional adapter only
# Kept for fallback experiments. When both are set, Dodo wins.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Payments: demo only
# HMAC secret used to sign /checkout/mock -> /api/webhooks/payments demo payloads.
# Optional for local dev. Never use DEMO_WEBHOOK_SECRET in a real hosted payment
# environment. Any real provider/service key disables the demo payment path.
DEMO_WEBHOOK_SECRET=

# Rate limiting
# Shared fixed-window limiter over Upstash Redis REST. Required for
# multi-instance correctness on a real hosted beta deployment.
# Use one free Upstash database for the designated beta environment initially.
# Do not expose these credentials to ordinary untrusted PR previews.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
# Canonical public URL for the environment. OG cards and share links derive the
# host from this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring: optional
# Prefer the free Cloudflare live tail and the free GitHub Actions health
# workflow during sandbox/beta.
# SENTRY_DSN=

# Bot protection: optional until production gate
# When TURNSTILE_SECRET_KEY is set, /api/checkout verifies a Turnstile token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Current free-beta environment matrix
#
# Variable                         | Local/demo | Designated hosted beta | Real-money production
# NEXT_PUBLIC_SUPABASE_URL         | unset      | Priced project         | review at promotion
# NEXT_PUBLIC_SUPABASE_ANON_KEY    | unset      | Priced anon key        | review at promotion
# SUPABASE_SERVICE_ROLE_KEY        | unset      | beta only, server      | server only
# DODO_PAYMENTS_API_KEY            | unset      | TEST key               | LIVE key only after gate
# DODO_PAYMENTS_MODE               | unset      | test                   | live
# DODO_PAYMENTS_PRODUCT_ID         | unset      | test/approved product  | live product
# DODO_PAYMENTS_WEBHOOK_KEY        | unset      | TEST webhook key       | LIVE webhook key
# DODO_PAYMENTS_CURRENCY           | USD        | USD                    | USD (one settlement currency)
# QUOTE_LATE_PAYMENT_GRACE_MS      | 0 (locked) | owner decision         | owner decision
# DODO_PAYMENTS_BASE_URL           | unset      | unset                  | unset (test override only)
# UPSTASH_REDIS_REST_URL           | unset      | free beta Redis        | revisit isolation
# UPSTASH_REDIS_REST_TOKEN         | unset      | free beta token        | revisit isolation
# NEXT_PUBLIC_APP_URL              | localhost  | stable beta URL        | canonical production URL
# TURNSTILE_SECRET_KEY             | unset      | optional               | recommended
# NEXT_PUBLIC_TURNSTILE_SITE_KEY   | unset      | optional               | recommended
# SENTRY_DSN                       | unset      | optional               | optional
# DEMO_WEBHOOK_SECRET              | optional   | NEVER with real keys   | NEVER
# STRIPE_SECRET_KEY                | unset      | unset                  | optional fallback only
# STRIPE_WEBHOOK_SECRET            | unset      | unset                  | optional fallback only
#
# Isolation rules for the current free phase:
# 1. Only the designated beta deployment gets Supabase service-role, Dodo TEST,
#    and Upstash credentials. Ordinary PR previews remain credential-free demo mode.
# 2. Do not create a second Priced Supabase project just to satisfy an older
#    Preview/Production matrix while the owner is staying on free infrastructure.
# 3. Never put Dodo LIVE credentials into Preview or the sandbox beta environment.
# 4. DEMO_* is incompatible with a real provider/service configuration.
# 5. Credits remain OFF (no credit code path or flag exists yet).
# 6. Before accepting real customer payments, revisit environment isolation,
#    logical backups/disaster recovery, production hosting plan compliance,
#    legal/support readiness, and separate live payment credentials.
